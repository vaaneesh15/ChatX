{
  "name": "TapX Clicker",
  "short_name": "TapX",
  "description": "Адаптивный офлайн-кликер для iOS и GitHub Pages.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f9f6",
  "theme_color": "#13a86b",
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
